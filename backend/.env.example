PORT=5000
MONGO_URI=mongodb://localhost:27017/smart-ats

# Must be at least 32 characters (e.g. `openssl rand -hex 32`)
JWT_SECRET=
JWT_EXPIRE=7d

# Comma-separated list of browser origins allowed to call the API
CLIENT_URL=http://localhost:3000

AI_SERVICE_URL=http://localhost:8000
# Shared secret the backend sends to the AI service as X-API-Key
AI_SERVICE_API_KEY=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Only used by `node seedAdmin.js`
ADMIN_EMAIL=admin@talentpilot.ai
ADMIN_PASSWORD=
